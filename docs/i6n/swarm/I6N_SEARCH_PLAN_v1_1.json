 "interpretations": [
  {
   "id": "INT-STRIDE",
   "status": "RULED",
   "text": "RULED 2026-10-11 (Satoshi): '1 o 2 por capa' is the domain, a free per-reducer 1|2 list; none/progressive/final are named patterns used as labels and seeds. Combinations that lose t or leave fewer than min_final_steps are still rejected (FINAL_STEPS_BELOW_MINIMUM). Plan v1.1 is a strict superset of v1.0.0; every v1.0.0 in-domain genotype_canonical_sha256 is unchanged."
  },
  {
   "id": "INT-REDUCER-ORDER",
   "text": "non-increasing includes the entrance width (inherited search contract; legacy candidates obey it)."
  },
  {
   "id": "INT-S1-DOWNSAMPLED",
   "text": "S1 requires dx>=2 ('primero downsampling, despues horario'); hourly grids start at S2."
  },
  {
   "id": "INT-CLASS-WIDTH",
   "text": "class width limit applies to entrance, reducer and adapter widths."
  },
  {
   "id": "INT-MIN-STEPS",
   "text": "a reduction may not leave fewer than 2 temporal steps (inherited model rule)."
  },
  {
   "id": "INT-SEED-WINDOW",
   "text": "seed window = smallest history with a downsampled S1 grid, then its finest dx."
  },
  {
   "id": "INT-ALTERNATIVE",
   "text": "small alternative = Conv16 -> Conv8 -> Conv4, same window, no Transformer."
  },
  {
   "id": "INT-CACHE-SLOT",
   "text": "a verified cache hit occupies a population slot and acts as parent but is not a new candidate or fit."
  },
  {
   "id": "INT-LEGACY",
   "text": "the 48 legacy endpoint candidates are not injected into the population: their scores come from one inner interval before week 2024-01-07, which overlaps the 2023Q4 inner period."
  }
 ],
