    {"id": "FBR-010", "text": "La elegibilidad exige utilidad incremental fuera de muestra.", "status": "DRAFT", "source": "propuesta doctoral"},
    {"id": "FBR-011", "text": "Toda comparacion conserva raw y controles de igual anchura o costo.", "status": "DRAFT", "source": "propuesta doctoral"},
