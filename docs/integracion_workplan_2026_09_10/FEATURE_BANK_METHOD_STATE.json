  "requirements": [
    {"id": "FBR-001", "text": "Toda feature debe declarar padres, formula, parametros e identidad.", "status": "DRAFT", "source": "auditoria feature-eng"},
    {"id": "FBR-002", "text": "Una salida temporal no puede depender de observaciones futuras.", "status": "DRAFT", "source": "requisito del propietario"},
    {"id": "FBR-003", "text": "Todo estado aprendido debe ajustarse exclusivamente en training.", "status": "DRAFT", "source": "plan CRISP-DM"},
