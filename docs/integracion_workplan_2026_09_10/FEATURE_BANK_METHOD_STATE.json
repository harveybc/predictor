    {"id": "FBR-005", "text": "Los cruces entre fuentes deben respetar el tiempo de disponibilidad.", "status": "DRAFT", "source": "plan D0-D5"},
    {"id": "FBR-006", "text": "Targets y features deben tener registros y caminos de ejecucion separados.", "status": "DRAFT", "source": "auditoria feature-eng"},
    {"id": "FBR-007", "text": "Ausencias y warm-up deben conservar una semantica explicita.", "status": "DRAFT", "source": "auditoria feature-eng"},
    {"id": "FBR-008", "text": "Cada feature debe medir costo, memoria, warm-up y retardo.", "status": "DRAFT", "source": "plan data-centric"},
