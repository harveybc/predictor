=== tools/i6m_data.py :48-55
    48	def partitions(ts, y, week, horizon, require_fit=True):
    49	    """Purge label endpoints and require all physical input support inside TRAIN."""
    50	    start, cut = epoch(week["fit_start"]), epoch(week["fit_cutoff"])
    51	    inner = cut-28*86400
    52	    valid = np.isfinite(y)
    53	    support = ts-2*horizon*3600 >= start
    54	    fit = np.flatnonzero(valid & support & (ts+horizon*3600 < inner))
    55	    vi = np.flatnonzero(valid & support & (ts >= inner) & (ts+horizon*3600 < cut))

