[Unit]
Description=I6-DMO @CID@ tick (finite stage advance, gates, readiness, STATUS.json)
@MARK@
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@WORKDIR@
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=CUDA_VISIBLE_DEVICES=
ExecStart=@PYTHON@ -m tools.i6dmo tick --root @ROOT@
MemoryMax=1G
TimeoutStartSec=900
Nice=10
