# ~/.config/fs4/<slot>.env template for an FS4 RAW slot (copy per host, chmod 0600, UNTRACKED).
# Every <...> is resolved from paths already verified on that host; SSH aliases live only here.
# install_host.sh refuses while any value is a PENDING_* placeholder or not real.
FS4_PYTHON=<state>/venv/bin/python
FS4_CODE=<state>/code/PREDICTOR_CURRENT
FS4_COORDINATOR=<ssh-alias-of-the-coordinator-from-this-host>
FS4_COORDINATOR_PYTHON=python3
FS4_CONTROLLER=<coordinator-absolute-path>/code/PREDICTOR_CURRENT/tools/fs4_campaign.py
FS4_DB=<coordinator-absolute-path>/fs4/queue_v2.sqlite
FS4_OWNER=<role>-cpu-raw
FS4_RUNNER=<state>/bin/fs4-runner
FS4_CAP=PENDING_MEASURED_CAP
FS4_ARM=RAW
FS4_OUTPUT_ROOT=<state>/terminals
FS4_WALL=2h
FS4_TIMEOUT=7500
