# ~/.config/fs4/<slot>.env for a WEEKLY encoder slot (stage 2: RANDOM_ENCODER or TRAINED_ENCODER). Same variables as
# weekly-raw.env.template plus the runner's retained terminals and the pinned feature-extractor checkout.
# Add FS4_GPU_UUID=<physical UUID> only to put the predictor fit on that GPU; without it the child sees no GPU.
FS4_INPUT_MODE=TRAINED_ENCODER
FS4_RUNNER_RESULTS=<state>/fs4/terminals_collected   # <task_id>/result.json + chosen.weights.h5 of the phase-4 runner, fold inner_2023
FS4_EXTRACTOR_CODE=<state>/code/feature-extractor-deffa53
